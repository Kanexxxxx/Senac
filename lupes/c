<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contas do Mes</title>
</head>
<body>
    <img src="../IMG/exerc.jpg" alt="Contas a pagar" class="alta">
    <h1>Programa Contas do Mes</h1>
    <form>
        <p>Descricao da conta:
            <input type="text" id="inDescricao" required>
        </p>
        <p>Valor R$:
            <input type="number" id="inValor" min="0" step="0.01" required>
        </p>
        <input type="submit" value="Registrar conta">
    </form>
    <pre id="outResp1"></pre>
    <pre id="outResp2"></pre>
    <pre id="outResp3"></pre>
    <script src="../JS/compras.js"></script>
</body>
</html>
